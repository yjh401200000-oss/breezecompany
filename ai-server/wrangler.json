{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breeze-ai",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": { "GROQ_MODEL": "qwen/qwen3.6-27b", "AI_DAILY_LIMIT": "100" },
  "ratelimits": [{ "name": "AI_RATE_LIMITER", "namespace_id": "26090901", "simple": { "limit": 5, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "AI_BUDGET", "class_name": "DailyBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyBudget"] }]
}
